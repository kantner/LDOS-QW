\psi_{N} & =\mathrm{e}^{-ikz_{N}}+R\mathrm{e}^{ikz_{N}}\\
\psi_{N+1} & =\mathrm{e}^{-ik\left(z_{N}+\Delta z\right)}+R\mathrm{e}^{ik\left(z_{N}+\Delta z\right)}
