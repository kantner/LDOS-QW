-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(\psi_{l+1}-2\psi_{l}+\psi_{l-1}\right) & =E\psi_{l}\\
\psi_{l} & \sim\mathrm{e}^{ikl\Delta z}\\
-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(\mathrm{e}^{ik\Delta z}-2+\mathrm{e}^{-ik\Delta z}\right) & =E
\end{align*}

\end_inset

such that
\begin_inset Formula 
\begin{align*}
E & =\frac{\hbar^{2}}{m^{*}\Delta z^{2}}\left(1-\cos\left(k\Delta z\right)\right)=\frac{\hbar^{2}}{m^{*}\Delta z^{2}}\left(1-\cos\left(k\Delta z\right)\right)\\
 & =\frac{2\hbar^{2}}{m^{*}\Delta z^{2}}\sin^{2}\left(\frac{k\Delta z}{2}\right)\\
 & \approx\frac{\hbar^{2}k^{2}}{2m^{*}}\left(1+\frac{1}{3}\left(\frac{k\Delta z}{2}\right)^{2}+\ldots\right)
\end{align*}

\end_inset

Then
\begin_inset Formula 
\begin{align*}
k & =\frac{1}{\Delta z}\arccos\left(1-\frac{m^{*}\Delta z^{2}}{\hbar^{2}}E\right)
\end{align*}

\end_inset

