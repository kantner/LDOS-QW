\begin_layout Plain Layout
We focus on the conduction band and make the ansatz
\begin_inset Formula 
\begin{align*}
\Psi_{n}\left(\mathbf{r}\right) & =u_{c,\mathbf{k}_{0}}\left(\mathbf{r}\right)F_{n}\left(\mathbf{r}\right)
\end{align*}

\end_inset

and in quantum well 
\begin_inset Formula 
\begin{align*}
F_{c,n}\left(\mathbf{r}\right)\to & F_{c,\mathbf{k}_{\parallel},n}\left(\mathbf{r}\right)=\frac{1}{\sqrt{A}}\mathrm{e}^{ik_{x}x}\mathrm{e}^{ik_{y}y}f_{n}\left(z\right)\\
E_{n}\to & E_{n,\mathbf{k}_{\parallel}}=\varepsilon_{n}+\frac{\hbar^{2}k^{2}_{\parallel}}{2m\left(z\right)}
\end{align*}

\end_inset

We omit the conduction band index 
\begin_inset Quotes eld
\end_inset

c
\begin_inset Quotes erd
\end_inset

 and select 
\begin_inset Formula $\mathbf{k}_{0}=\mathbf{0}$
\end_inset

.
 Then
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}\left(\mathbf{r},E\right) & =2\frac{1}{A}\sum_{n,\mathbf{k}_{\parallel}}\left|u_{c,\mathbf{k}_{0}}\left(\mathbf{r}\right)\right|^{2}\left|f_{n}\left(z\right)\right|^{2}\delta\left(E_{n}+\frac{\hbar^{2}k^{2}_{\parallel}}{2m\left(z\right)}-E\right)\\
 & 2\frac{1}{A}\sum_{n,\mathbf{k}_{\parallel}}\left|u_{c,\mathbf{k}_{0}}\left(\mathbf{r}\right)\right|^{2}\left|f_{n}\left(z\right)\right|^{2}\delta\left(E_{n}-E\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Plain Layout
Wave Functions
\end_layout

\begin_layout Plain Layout
Schrödinger equation for envelope
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2}\nabla\cdot\left(m^{-1}\left(\mathbf{r}\right)\nabla F\left(\mathbf{r}\right)\right)+U\left(\mathbf{r}\right)F\left(\mathbf{r}\right) & =EF\left(\mathbf{r}\right)
\end{align*}

\end_inset

with scalar (isotropic),
 position dependent effective mass 
\begin_inset Formula $m$
\end_inset

 and confinement potential 
\begin_inset Formula $U$
\end_inset

.
 We assume a quantum well nanostructure,
 i.e.,
 continuous translation invariance in the 
\begin_inset Formula $\left(x,y\right)$
\end_inset

 plane such that
\begin_inset Formula 
\begin{align*}
F\left(\mathbf{r}\right) & =\frac{1}{\sqrt{A}}\mathrm{e}^{ik_{x}x}\mathrm{e}^{ik_{y}y}f\left(z\right)\\
U\left(\mathbf{r}\right) & =U\left(z\right)\\
m\left(\mathbf{r}\right) & =m\left(z\right)
\end{align*}

\end_inset

Then
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2}\frac{\partial}{\partial z}\left(\frac{1}{m\left(z\right)}\frac{\partial f\left(z\right)}{\partial z}\right)+\frac{\hbar^{2}}{2m\left(z\right)}\left(k^{2}_{x}+k^{2}_{y}\right)f\left(z\right)+U\left(z\right)f\left(z\right) & =Ef\left(z\right)
\end{align*}

\end_inset

We assume an equidistant grid 
\begin_inset Formula $z_{l}=z_{1}+\left(l-1\right)\Delta z$
\end_inset

,
 
\begin_inset Formula $l=1\ldots N$
\end_inset

 and discretize by integration over boxes 
\begin_inset Formula $\Omega_{l}=\left[\frac{z_{l-1}+z_{l}}{2},\frac{z_{l}+z_{l+1}}{2}\right]$
\end_inset

 centered around nodes 
\begin_inset Formula $z_{l}$
\end_inset


\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2}\int_{\Omega_{l}}\mathrm{d}z\,\frac{\partial}{\partial z}\left(\frac{1}{m\left(z\right)}\frac{\partial f\left(z\right)}{\partial z}\right)+\int_{\Omega_{l}}\mathrm{d}z\,\frac{\hbar^{2}}{2m\left(z\right)}\left(k^{2}_{x}+k^{2}_{y}\right)f\left(z_{l}\right)+\int_{\Omega_{l}}\mathrm{d}z\,U\left(z\right)f\left(z\right) & =E\int_{\Omega_{l}}\mathrm{d}z\,f\left(z\right).
\end{align*}

\end_inset

We assume the effective mass and the potential to be constant along edges between nodes,
 e.g.
 
\begin_inset Formula $U\left(z_{l}\leq z\leq z_{l+1}\right)=U_{l}$
\end_inset

 and Robin type BCs
\begin_inset Formula 
\begin{align*}
f'\left(z_{1}\right) & =\alpha_{\mathrm{left}}f\left(z_{1}\right)+\beta_{\mathrm{left}}\\
f'\left(z_{N}\right) & =\alpha_{\mathrm{right}}f\left(z_{N}\right)+\beta_{\mathrm{right}}
\end{align*}

\end_inset

BCs will be detailed below.
\end_layout

\begin_layout Plain Layout
Then 
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2}\left(\frac{1}{m_{l}}\frac{f_{l+1}-f_{l}}{\Delta z}-\frac{1}{m_{l-1}}\frac{f_{l}-f_{l-1}}{\Delta z}\right)+\Delta z\frac{\hbar^{2}}{2}\left(k^{2}_{x}+k^{2}_{y}\right)\frac{1}{2}\left(\frac{1}{m_{l-1}}+\frac{1}{m_{l}}\right)f_{l}+\frac{\Delta z}{2}\left(U_{l-1}+U_{l}\right)f_{l} & =E\Delta zf_{l}\qquad l=2\ldots N-2
\end{align*}

\end_inset

where 
\begin_inset Formula $f_{l}=f\left(z_{l}\right)$
\end_inset

.
 At the boundaries we find
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2}\int_{\Omega_{l}}\mathrm{d}z\,\frac{\partial}{\partial z}\left(\frac{1}{m\left(z\right)}\frac{\partial f\left(z\right)}{\partial z}\right)+\int_{\Omega_{l}}\mathrm{d}z\,\frac{\hbar^{2}}{2m\left(z\right)}\left(k^{2}_{x}+k^{2}_{y}\right)f\left(z_{l}\right)+\int_{\Omega_{l}}\mathrm{d}z\,U\left(z\right)f\left(z\right) & =E\int_{\Omega_{l}}\mathrm{d}z\,f\left(z\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Plain Layout
We write this as
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2\Delta z^{2}}\frac{1}{m_{l}}f_{l+1}-\frac{\hbar^{2}}{2\Delta z^{2}}\frac{1}{m_{l-1}}f_{l-1}+\frac{\hbar^{2}}{2\Delta z^{2}}\left(\frac{1}{m_{l}}+\frac{1}{m_{l-1}}\right)f_{l}+\frac{\hbar^{2}}{2}\left(k^{2}_{x}+k^{2}_{y}\right)\frac{1}{2}\left(\frac{1}{m_{l-1}}+\frac{1}{m_{l}}\right)f_{l}+\frac{1}{2}\left(U_{l-1}+U_{l}\right)f_{l} & =Ef_{l}\\
\\l=1\qquad-\frac{\hbar^{2}}{2\Delta z^{2}}\frac{1}{m_{1}}\left(f_{2}-f_{1}\right)+\frac{\hbar^{2}}{2\Delta z}\frac{1}{m_{1}}\frac{\partial f}{\partial z}\left(0\right)+\frac{\hbar^{2}}{2}\left(k^{2}_{x}+k^{2}_{y}\right)\frac{1}{2}\left(\frac{1}{m_{0}}+\frac{1}{m_{1}}\right)f_{l}+\frac{1}{2}\left(U_{0}+U_{1}\right)f_{1} & =Ef_{1}\\
\rightarrow\qquad-\frac{\hbar^{2}}{2\Delta z^{2}}\frac{1}{m_{1}}\left(f_{2}-f_{1}\right)+\underline{\frac{\hbar^{2}}{2\Delta z}\frac{1}{m_{1}}2ik_{E}}-\frac{\hbar^{2}}{2\Delta z}\frac{1}{m_{1}}ik_{E}f_{1}+\frac{\hbar^{2}}{2}\left(k^{2}_{x}+k^{2}_{y}\right)\frac{1}{2}\left(\frac{1}{m_{0}}+\frac{1}{m_{1}}\right)f_{l}+\frac{1}{2}\left(U_{0}+U_{1}\right)f_{1} & =Ef_{1}\\
\leftarrow\qquad-\frac{\hbar^{2}}{2\Delta z^{2}}\frac{1}{m_{1}}\left(f_{2}-f_{1}\right)-\frac{\hbar^{2}}{2\Delta z}\frac{1}{m_{1}}ik_{E}f_{1}+\frac{\hbar^{2}}{2}\left(k^{2}_{x}+k^{2}_{y}\right)\frac{1}{2}\left(\frac{1}{m_{0}}+\frac{1}{m_{1}}\right)f_{l}+\frac{1}{2}\left(U_{0}+U_{1}\right)f_{1}\\
l=2\qquad-\frac{\hbar^{2}}{2\Delta z^{2}}\frac{1}{m_{2}}f_{3}-\frac{\hbar^{2}}{2\Delta z^{2}}\frac{1}{m_{1}}f_{1}+\frac{\hbar^{2}}{2\Delta z^{2}}\left(\frac{1}{m_{2}}+\frac{1}{m_{1}}\right)f_{2}+\frac{\hbar^{2}}{2}\left(k^{2}_{x}+k^{2}_{y}\right)\frac{1}{2}\left(\frac{1}{m_{1}}+\frac{1}{m_{2}}\right)f_{2}+\frac{1}{2}\left(U_{1}+U_{2}\right)f_{2} & =Ef_{2}
\end{align*}

\end_inset

BC:
 incoming wave from left
\begin_inset Formula 
\begin{align*}
f^{\rightarrow}\left(z\leq0\right) & =\mathrm{e}^{ik_{E}z}+R\mathrm{e}^{-ik_{E}z}\\
f^{\rightarrow}\left(z\geq L\right) & =T\mathrm{e}^{ik_{E}z}\\
k_{E} & =\frac{\sqrt{2m\left(0\right)\left(E-U\left(0\right)\right)}}{\hbar}
\end{align*}

\end_inset

Then
\begin_inset Formula 
\begin{align*}
\frac{\partial f^{\rightarrow}}{\partial z}\left(0\right) & =ik_{E}\left(\mathrm{e}^{ik_{E}z}-R\mathrm{e}^{-ik_{E}z}\right)\\
 & =\underbrace{2ik_{E}\mathrm{e}^{ik_{E}z}}_{\text{injection}}\vert_{z=0}\underbrace{-ik_{E}f^{\rightarrow}\left(0\right)}_{\text{outgoing wave}}\\
 & =2ik_{E}-ik_{E}f^{\rightarrow}\left(0\right)\\
\frac{\partial f^{\rightarrow}}{\partial z}\left(L\right) & =ik_{E}f^{\rightarrow}\left(L\right)
\end{align*}

\end_inset

Incoming wave from right
\begin_inset Formula 
\begin{align*}
f^{\leftarrow}\left(z\geq L\right) & =\mathrm{e}^{-ik_{E}z}+R\mathrm{e}^{+ik_{E}z}\\
k_{E} & =\frac{\sqrt{2m\left(L\right)U\left(L\right)}}{\hbar}\\
\frac{\partial f^{\leftarrow}}{\partial z}\vert_{L} & =-2ik_{E}\mathrm{e}^{-ik_{E}L}+ik_{E}f^{\leftarrow}\left(L\right)\\
f^{\leftarrow}\left(z\leq0\right) & =T\mathrm{e}^{-ik_{E}z}\\
f^{\leftarrow}\left(0\right) & =-ik_{E}f^{\leftarrow}\left(0\right)
\end{align*}

\end_inset


