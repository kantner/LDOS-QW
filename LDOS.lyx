 with energy 
\begin_inset Formula $E\geq U\left(0\right)$
\end_inset

 is written as
\begin_inset Formula 
\begin{align*}
\psi^{\rightarrow}\left(z\right) & =\mathrm{e}^{ik^{\rightarrow}_{E}z}+R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z}\qquad\left(z\leq0\right)
\end{align*}

\end_inset


\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
\left|\psi^{\rightarrow}\left(z\right)\right|^{2} & =1+\left|R^{\rightarrow}\right|^{2}+2\mathrm{Re}\left(R^{\rightarrow*}\mathrm{e}^{2ik^{\rightarrow}_{E}z}\right)\\
\mathrm{e}^{ik^{\rightarrow}_{E}z}\psi^{\rightarrow}\left(z\right)-\mathrm{e}^{2ik^{\rightarrow}_{E}z} & =+R^{\rightarrow}\\
\\\psi^{\rightarrow}\left(L\right)\mathrm{e}^{-ik^{\rightarrow}_{E}L} & =T^{\rightarrow}\\
\\\psi^{\rightarrow}\left(z\right) & =\mathrm{e}^{ik^{\rightarrow}_{E}z}+R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z}\qquad\left(z\leq0\right)\\
\\\psi^{\rightarrow}\left(0\right) & =1+R^{\rightarrow}\\
\psi^{\rightarrow}\left(-\Delta z\right) & =\mathrm{e}^{-ik^{\rightarrow}_{E}\Delta z}+R^{\rightarrow}\mathrm{e}^{ik^{\rightarrow}_{E}\Delta z}\\
\\\mathrm{e}^{-ik^{\rightarrow}_{E}\Delta z}\psi^{\rightarrow}\left(-\Delta z\right) & =\mathrm{e}^{-2ik^{\rightarrow}_{E}\Delta z}+R^{\rightarrow}\\
\\\mathrm{e}^{-ik^{\rightarrow}_{E}\Delta z}\psi^{\rightarrow}\left(-\Delta z\right)-\mathrm{e}^{-2ik^{\rightarrow}_{E}\Delta z} & =\psi^{\rightarrow}\left(0\right)-1\\
\psi^{\rightarrow}\left(-\Delta z\right)-\psi^{\rightarrow}\left(0\right) & =\mathrm{e}^{ik^{\rightarrow}_{E}\Delta z}\psi^{\rightarrow}\left(0\right)-\psi^{\rightarrow}\left(0\right)-2i\sin\left(k^{\rightarrow}_{E}\Delta z\right)\\
 & \approx ik^{\rightarrow}_{E}\Delta z\psi^{\rightarrow}\left(0\right)-2i\sin\left(k^{\rightarrow}_{E}\Delta z\right)\\
\frac{\psi^{\rightarrow}\left(-\Delta z\right)-\psi^{\rightarrow}\left(0\right)}{\Delta z} & \approx ik^{\rightarrow}_{E}\left(\psi^{\rightarrow}\left(0\right)-2\underbrace{\frac{\sin\left(k^{\rightarrow}_{E}\Delta z\right)}{k^{\rightarrow}_{E}\Delta z}}_{\to1}\right)
\end{align*}

\end_inset


\end_layout

\end_inset

where the first term is the incoming wave and the second term is the wave reflected from the domain of interest.
 At the boundary 
\begin_inset Formula $z=0$
\end_inset

 it holds
\begin_inset Formula 
\begin{align*}
\frac{\partial\psi^{\rightarrow}}{\partial z}\vert_{z=0} & =ik^{\rightarrow}_{E}\left(\mathrm{e}^{ik^{\rightarrow}_{E}z}-R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z}\right)\vert_{z=0}\\
 & =ik^{\rightarrow}_{E}\left(2\mathrm{e}^{ik^{\rightarrow}_{E}z}-\psi^{\rightarrow}\left(z\right)\right)\vert_{z=0}\\
 & =2ik^{\rightarrow}_{E}-ik^{\rightarrow}_{E}\psi^{\rightarrow}\left(0\right)
\end{align*}

\end_inset

This is a Robin type BC.
 The wave vector is
\begin_inset Formula 
\begin{align*}
k^{\rightarrow}_{E} & =\frac{\sqrt{2m^{*}\left(E-U\left(0\right)\right)}}{\hbar}.
\end{align*}

\end_inset

 Similarly,
 the wave function of the electron leaving the domain on the right hand side boundary reads
\begin_inset Formula 
\begin{align*}
\psi^{\rightarrow}\left(z\right) & =T^{\rightarrow}\mathrm{e}^{ik^{\rightarrow}_{E}z}\qquad\left(z\geq L\right)
\end{align*}

\end_inset

This implies the inhomogeneous Neumann BC
\begin_inset Formula 
\begin{align*}
\frac{\partial\psi^{\rightarrow}}{\partial z}\vert_{z=L} & =ik^{\rightarrow}_{E}\psi^{\rightarrow}\left(L\right).
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
In full analogy,
 we treat a 
\series bold
particle entering from the right
\series default
 hand side with energy 
\begin_inset Formula $E\geq U\left(L\right)$
\end_inset

 assuming
\begin_inset Formula 
\begin{align*}
\psi^{\leftarrow}\left(z\right) & =\mathrm{e}^{-ik^{\leftarrow}_{E}z}+R^{\leftarrow}\mathrm{e}^{ik^{\leftarrow}_{E}z}\qquad\left(z\geq L\right)\\
\psi^{\leftarrow}\left(z\right) & =T^{\leftarrow}\mathrm{e}^{-ik^{\leftarrow}_{E}z}\qquad\left(z\leq0\right)
\end{align*}

\end_inset

and
