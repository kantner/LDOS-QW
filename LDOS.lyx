\psi_{0} & =\psi_{1}\mathrm{e}^{ik\Delta z}\\
\psi_{N+1} & =\mathrm{e}^{ik\Delta z}\psi_{N}-\mathrm{e}^{-ikz_{N}}2i\sin\left(k\Delta z\right)
\end{align*}

