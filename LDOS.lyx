-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{2}+\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{1}\left(2-\mathrm{e}^{ik\Delta z}\right)+\left(U_{1}-E\right)\psi_{1} & =0\\
\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(2-\mathrm{e}^{ik\Delta z}\right)\psi_{N}-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{N-1}+\left(U_{N}-E\right)\psi_{N} & =-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\mathrm{e}^{-ikz_{N}}2i\sin\left(k\Delta z\right)
\end{align*}

\end_inset


