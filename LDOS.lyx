At the right facet we find
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2m^{*}}\frac{2}{\Delta z}\left(\alpha_{L}\psi_{N}+\beta_{L}-\frac{\psi_{N}-\psi_{N-1}}{\Delta z}\right)+U_{N}\psi_{N} & =E\psi_{N}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\frac{\hbar^{2}}{2m^{*}\left(\Delta z\right)^{2}}2\left(1-\Delta z\alpha_{L}\right)\psi_{N}-\frac{\hbar^{2}}{2m^{*}\left(\Delta z\right)^{2}}2\psi_{N-1}+\left(U_{N}-E\right)\psi_{N} & =+\frac{\hbar^{2}}{2m^{*}\left(\Delta z\right)^{2}}2\Delta z\beta_{L}
\end{align*}

