\begin{align*}
-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{2}+\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(2+\mathrm{e}^{ik\Delta z}\right)\psi_{1}+\left(U_{1}-E\right)\psi_{1} & =\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\mathrm{e}^{ikz_{1}}2i\sin\left(k\Delta z\right)\\
\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left\{ 2-\mathrm{e}^{ik\Delta z}\right\} \psi_{N}+\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{N-1}+\left(U_{N}-E\right)\psi_{N} & =0
\end{align*}

