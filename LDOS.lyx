\psi^{\rightarrow}\left(z\right) & =\mathrm{e}^{ik^{\rightarrow}_{E}z}+R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z}\qquad\left(z\leq0\right)
\end{align*}

\end_inset

becomes
\begin_inset Formula 
\begin{align*}
\psi_{1} & =\mathrm{e}^{ik^{\rightarrow}_{E}z_{1}}+R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z_{1}}\\
\psi_{0} & =\mathrm{e}^{ik^{\rightarrow}_{E}z_{0}}+R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z_{0}}=\mathrm{e}^{ik^{\rightarrow}_{E}z_{1}}\mathrm{e}^{-ik^{\rightarrow}_{E}\Delta z}+R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z_{1}}\mathrm{e}^{ik^{\rightarrow}_{E}\Delta z}\\
 & =\mathrm{e}^{ik^{\rightarrow}_{E}z_{1}}\mathrm{e}^{-ik^{\rightarrow}_{E}\Delta z}+\left(\psi_{1}-\mathrm{e}^{ik^{\rightarrow}_{E}z_{1}}\right)\mathrm{e}^{ik^{\rightarrow}_{E}\Delta z}\\
\psi_{0} & =\mathrm{e}^{ik^{\rightarrow}_{E}\Delta z}\psi_{1}-2i\mathrm{e}^{ik^{\rightarrow}_{E}z_{1}}\sin\left(k^{\rightarrow}_{E}\Delta z\right)\\
\frac{\psi_{1}-\psi_{0}}{\Delta z} & =-ik^{\rightarrow}_{E}\mathrm{e}^{i\frac{k^{\rightarrow}_{E}\Delta z}{2}}\frac{\sin\left(\frac{k^{\rightarrow}_{E}\Delta z}{2}\right)}{\frac{k^{\rightarrow}_{E}\Delta z}{2}}\psi_{1}+2ik^{\rightarrow}_{E}\mathrm{e}^{ik^{\rightarrow}_{E}z_{1}}\frac{\sin\left(k^{\rightarrow}_{E}\Delta z\right)}{k^{\rightarrow}_{E}\Delta z}
\end{align*}

\end_inset


\begin_inset Formula 
\begin{align*}
\frac{\partial\psi^{\rightarrow}}{\partial z}\vert_{z=0} & =ik^{\rightarrow}_{E}\left(\mathrm{e}^{ik^{\rightarrow}_{E}z}-R^{\rightarrow}\mathrm{e}^{-ik^{\rightarrow}_{E}z}\right)\vert_{z=0}\\
 & =ik^{\rightarrow}_{E}\left(2\mathrm{e}^{ik^{\rightarrow}_{E}z}-\psi^{\rightarrow}\left(z\right)\right)\vert_{z=0}\\
 & =2ik^{\rightarrow}_{E}-ik^{\rightarrow}_{E}\psi^{\rightarrow}\left(0\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Plain Layout
Then
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{2}+\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left[2+\mathrm{e}^{ik^{\rightarrow}_{E}\Delta z}\right]\psi_{1}-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}2i\mathrm{e}^{ik^{\rightarrow}_{E}z_{1}}\sin\left(k^{\rightarrow}_{E}\Delta z\right)+U_{1}\psi_{1} & =E\psi_{1}
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

\end_inset


