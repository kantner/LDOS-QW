leading to BCs
\begin_inset Formula 
\begin{align*}
\frac{\partial\psi^{\leftarrow}}{\partial z}\vert_{z=L} & =+ik^{\leftarrow}_{E}\psi^{\leftarrow}\left(L\right)-2ik^{\leftarrow}_{E}\mathrm{e}^{-ik^{\leftarrow}_{E}L}\\
\frac{\partial\psi^{\leftarrow}}{\partial z}\vert_{z=0} & =-ik^{\leftarrow}_{E}\psi^{\leftarrow}\left(0\right)
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
We summarize this as
\begin_inset Formula 
\begin{align*}
\frac{\partial\psi}{\partial z}\vert_{z=0} & =\alpha_{0}\psi\left(0\right)+\beta_{0}\\
\frac{\partial\psi}{\partial z}\vert_{z=L} & =\alpha_{L}\psi\left(L\right)+\beta_{L}
\end{align*}

\end_inset

with coefficient
\begin_inset Formula 
\begin{align*}
\alpha_{0} & =\begin{cases}
-ik^{\rightarrow}_{E} & \rightarrow\\
-ik^{\leftarrow}_{E} & \leftarrow
\end{cases} & \alpha_{L} & =\begin{cases}
ik^{\rightarrow}_{E} & \rightarrow\\
ik^{\leftarrow}_{E} & \leftarrow
\end{cases}\\
\beta_{0} & =\begin{cases}
2ik^{\rightarrow}_{E} & \rightarrow\\
0 & \leftarrow
\end{cases} & \beta_{L} & =\begin{cases}
0 & \rightarrow\\
-2ik^{\leftarrow}_{E}\mathrm{e}^{-ik^{\leftarrow}_{E}L} & \leftarrow
\end{cases}
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
For a bound state with energy 
\begin_inset Formula $\min\left(U\left(z\right)\right)<E<\min\left(U\left(0\right),U\left(L\right)\right)$
\end_inset

 the choice of BCs is of minor importance.
 
\end_layout

\begin_layout Standard
\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
Normalization
\begin_inset Formula 
\begin{align*}
\psi\left(z\right)= & \begin{cases}
\mathrm{e}^{ikz}+R\mathrm{e}^{-ikz}\\
\psi\left(z\right)\\
T\mathrm{e}^{ikz}
\end{cases}\\
\int\mathrm{d}z\,\psi^{*}_{E,\rightarrow}\left(z\right)\psi_{E,\rightarrow}\left(z\right) & =\begin{cases}
\int\mathrm{d}z\,\left(\mathrm{e}^{-ik^{\rightarrow}_{E}z}+R^{\rightarrow*}\left(E\right)\mathrm{e}^{ik^{\rightarrow}_{E}z}\right)\left(\mathrm{e}^{ik^{\rightarrow}_{E}z}+R^{\rightarrow}\left(E\right)\mathrm{e}^{-ik^{\rightarrow}_{E}z}\right)\\
\int\mathrm{d}z\,\left|\psi_{E}\left(z\right)\right|^{2}\\
\int\mathrm{d}z\,T^{\rightarrow*}\left(E\right)\mathrm{e}^{-ik_{E}z}T^{\rightarrow}\left(E\right)\mathrm{e}^{ik_{E}z}
\end{cases}\\
 & =\begin{cases}
\int^{0}_{-\infty}\mathrm{d}z\,+R^{\rightarrow*}\left(E\right)\int^{0}_{-\infty}\mathrm{d}z\,\mathrm{e}^{2ik^{\rightarrow}_{E}z}+R^{\rightarrow}\left(E\right)\int^{0}_{-\infty}\mathrm{d}z\,\mathrm{e}^{-2ik^{\rightarrow}_{E}z}+\left|R^{\rightarrow}\left(E\right)\right|^{2}\int^{0}_{-\infty}\mathrm{d}z\,\\
\int^{L}_{0}\mathrm{d}z\,\left|\psi_{E}\left(z\right)\right|^{2}\\
\left|T^{\rightarrow}\left(E\right)\right|^{2}\int^{\infty}_{L}\mathrm{d}z\,
\end{cases}\\
 & =\left(1+\left|R^{\rightarrow}\left(E\right)\right|^{2}\right)\int^{0}_{-\infty}\mathrm{d}z\,+R^{\rightarrow*}\left(E\right)\int^{0}_{-\infty}\mathrm{d}z\,\mathrm{e}^{2ik^{\rightarrow}_{E}z}+R^{\rightarrow}\left(E\right)\int^{0}_{-\infty}\mathrm{d}z\,\mathrm{e}^{-2ik^{\rightarrow}_{E}z}+\int^{L}_{0}\mathrm{d}z\,\left|\psi_{E}\left(z\right)\right|^{2}+\left|T^{\rightarrow}\left(E\right)\right|^{2}\int^{\infty}_{L}\mathrm{d}z\,\\
\end{align*}

\end_inset

Wir bruachen sowas wie 
\begin_inset Formula 
\begin{align*}
\int\mathrm{d}z\,\psi^{*}_{E,\rightarrow}\left(z\right)\psi_{E',\rightarrow}\left(z\right) & =\delta_{E,E'}\\
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Section
Finite Differences
\end_layout

\begin_layout Standard
We assume an equidistant grid 
\begin_inset Formula $z_{l}=\left(l-1\right)\Delta z$
\end_inset

,
 
\begin_inset Formula $l=1\ldots N$
\end_inset

,
 
\begin_inset Formula $\Delta z=L/\left(N-1\right)$
\end_inset

 and 
\begin_inset Formula $\psi\left(z_{l}\right)=\psi_{l}$
\end_inset

,
 
\begin_inset Formula $U\left(z_{l}\right)=U_{l}$
\end_inset

.
 We discretize the equation for the inner points
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2m^{*}}\frac{\psi_{l+1}-2\psi_{l}+\psi_{l-1}}{\Delta z^{2}}+U_{l}\psi_{l} & =E\psi_{l}\qquad2\leq l\leq N-1
\end{align*}

\end_inset


\end_layout

\begin_layout Standard
Without the potential,
 we find the discrete dispersion relation for plane waves 
\begin_inset Formula $\psi_{l}\sim\mathrm{e}^{ikz_{l}}=\mathrm{e}^{ik\left(l-1\right)\Delta z}$
\end_inset

 
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(\mathrm{e}^{ik\Delta z}-2+\mathrm{e}^{-ik\Delta z}\right) & =E
\end{align*}

\end_inset

such that
\begin_inset Formula 
\begin{align*}
E & =\frac{2\hbar^{2}}{m^{*}\Delta z^{2}}\sin^{2}\left(\frac{k\Delta z}{2}\right)\approx\frac{\hbar^{2}k^{2}}{2m^{*}}\left(1+\frac{1}{3}\left(\frac{k\Delta z}{2}\right)^{2}+\ldots\right)
\end{align*}

\end_inset

At the left and right facet we find
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(\psi_{2}-2\psi_{1}+\psi_{0}\right)+U_{1}\psi_{1} & =E\psi_{1}\\
-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(\psi_{N+1}-2\psi_{N}+\psi_{N-1}\right)+U_{N}\psi_{N} & =E\psi_{N}
\end{align*}

\end_inset


\end_layout

\begin_layout Subsection
Incoming wave from left
\end_layout

\begin_layout Standard
We use
\begin_inset Formula 
\begin{align*}
\psi_{1} & =\mathrm{e}^{ikz_{1}}+R\mathrm{e}^{-ikz_{1}}\\
\psi_{0} & =\mathrm{e}^{ik\left(z_{1}-\Delta z\right)}+R\mathrm{e}^{-ik\left(z_{1}-\Delta z\right)}
\end{align*}

\end_inset

and
\begin_inset Formula 
\begin{align*}
\psi_{N} & =T\mathrm{e}^{ikz_{N}}\\
\psi_{N+1} & =T\mathrm{e}^{ik\left(z_{N}+\Delta z\right)}
\end{align*}

\end_inset

Then
\begin_inset Formula 
\begin{align*}
\psi_{0} & =\mathrm{e}^{ik\Delta z}\psi_{1}-\mathrm{e}^{ikz_{1}}2i\sin\left(k\Delta z\right)\\
\psi_{N+1} & =\psi_{N}\mathrm{e}^{ik\Delta z}
\end{align*}

\end_inset

This yields
\begin_inset Formula 
\begin{align*}
-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{2}+\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(2-\mathrm{e}^{ik\Delta z}\right)\psi_{1}+\left(U_{1}-E\right)\psi_{1} & =-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\mathrm{e}^{ikz_{1}}2i\sin\left(k\Delta z\right)\\
\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\left(2-\mathrm{e}^{ik\Delta z}\right)\psi_{N}-\frac{\hbar^{2}}{2m^{*}\Delta z^{2}}\psi_{N-1}+\left(U_{N}-E\right)\psi_{N} & =0
\end{align*}

\end_inset


\begin_inset Note Note
status collapsed

