\begin_layout Title
Local Density of States
\end_layout

\begin_layout Section
Local Density of States of a Quantum Well
\end_layout

\begin_layout Standard
Evaluate LDOS for conduction band in a nanostructure
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}\left(\mathbf{r},E\right) & =\sum_{n,\sigma}\left|\Psi_{n}\left(\mathbf{r}\right)\right|^{2}\delta\left(E_{n}-E\right)
\end{align*}

\end_inset

The wave function obeys
\begin_inset Formula 
\begin{align*}
\left(-\frac{\hbar^{2}}{2m^{*}}\nabla^{2}+U\left(\mathbf{r}\right)\right)\Psi_{n}\left(\mathbf{r}\right) & =E_{n}\Psi_{n}\left(\mathbf{r}\right)
\end{align*}

\end_inset

We assume a quantum well confinement potential 
\begin_inset Formula $U\left(\mathbf{r}\right)=U\left(z\right)$
\end_inset

 and a constant,
 isotropic effective mass 
\begin_inset Formula $m^{*}$
\end_inset

.
 We make the separation ansatz
\begin_inset Formula 
\begin{align*}
\Psi_{n}\left(\mathbf{r}\right)\to & \Psi_{n,\mathbf{k}_{\parallel}}\left(\mathbf{r}\right)=\frac{1}{\sqrt{A}}\mathrm{e}^{ik_{x}x}\mathrm{e}^{ik_{y}y}\psi_{n}\left(z\right)\\
E_{n}\to & E_{n,\mathbf{k}_{\parallel}}=E_{n}+\frac{\hbar^{2}k^{2}_{\parallel}}{2m^{*}}
\end{align*}

\end_inset

where 
\begin_inset Formula $\mathbf{k}_{\parallel}=\left(k_{x},k_{y}\right)$
\end_inset

 and 
\begin_inset Formula $A$
\end_inset

 is the in-plane area.
 Then the problem reduces to
\begin_inset Formula 
\begin{align*}
\left(-\frac{\hbar^{2}}{2m^{*}}\frac{\partial^{2}}{\partial z^{2}}+U\left(z\right)\right)\psi_{n}\left(z\right) & =E_{n}\psi_{n}\left(z\right).
\end{align*}

\end_inset

The LDOS is evaluated as
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}\left(\mathbf{r},E\right)\to\mathrm{LDOS}\left(z,E\right) & =\frac{1}{A}\sum_{n,\mathbf{k}_{\parallel},\sigma}\left|\psi_{n}\left(z\right)\right|^{2}\delta\left(E_{n,\mathbf{k}_{\parallel}}-E\right)\\
 & =\frac{2}{\left(2\pi\right)^{2}}\sum_{n}\int_{\mathbb{R}^{2}}\mathrm{d}^{2}k_{\parallel}\left|\psi_{n}\left(z\right)\right|^{2}\delta\left(E_{n}+\frac{\hbar^{2}k^{2}_{\parallel}}{2m^{*}}-E\right)\\
 & =\frac{2}{\left(2\pi\right)^{2}}\sum_{n}2\pi\int^{\infty}_{0}\mathrm{d}k\,k\left|\psi_{n}\left(z\right)\right|^{2}\delta\left(E_{n}+\frac{\hbar^{2}k^{2}}{2m^{*}}-E\right)\\
 & =\frac{2}{2\pi}\sum_{n}\frac{2m^{*}}{\hbar^{2}}\int^{\infty}_{0}\mathrm{d}k\,k\left|\psi_{n}\left(z\right)\right|^{2}\delta\left(k^{2}-\frac{2m^{*}\left(E-E_{n}\right)}{\hbar^{2}}=g\left(k\right)\right)\\
 & =\frac{2}{2\pi}\sum_{n}\frac{2m^{*}}{\hbar^{2}}\int^{\infty}_{0}\mathrm{d}k\,k\left|\psi_{n}\left(z\right)\right|^{2}\frac{1}{2k}\delta\left(k-\frac{\sqrt{2m^{*}\left(E-E_{n}\right)}}{\hbar}\right)\\
 & =\frac{m^{*}}{\pi\hbar^{2}}\sum_{n}\left|\psi_{n}\left(z\right)\right|^{2}\Theta\left(E-E_{n}\right)
\end{align*}

\end_inset

So far,
 we assumed a discrete set of eigenstates.
 In the following,
 we will distinguish bound states in the QW (labeled by 
\begin_inset Formula $n$
\end_inset

) from continuum states (indexed by their energy 
\begin_inset Formula $E$
\end_inset

) as
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}\left(z,E\right) & =\mathrm{LDOS}^{\mathrm{bound}}\left(z,E\right)+\mathrm{LDOS}^{\rightarrow}\left(z,E\right)+\mathrm{LDOS}^{\leftarrow}\left(z,E\right)
\end{align*}

\end_inset

where
\end_layout

\begin_layout Standard
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}^{\mathrm{bound}}\left(z,E\right) & =\frac{m^{*}}{\pi\hbar^{2}}\sum_{n}\left|\psi_{n}\left(z\right)\right|^{2}\Theta\left(E-E_{n}\right)
\end{align*}

\end_inset

For the propagating waves,
 we use their labeling by the wave number
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}^{\rightarrow}\left(z,E\right) & =\frac{m^{*}}{\pi\hbar^{2}}\int^{k_{\mathrm{max}}\left(E\right)}_{0}\mathrm{d}k\left|\psi_{k}\left(z\right)\right|^{2}\Theta\left(E-U\left(0\right)-\frac{\hbar^{2}k^{2}}{2m^{*}}\right)
\end{align*}

\end_inset

with continuum states normalized as
\begin_inset Formula 
\begin{align*}
\int\mathrm{d}z\,\psi^{*}_{k,d}\left(z\right)\psi_{k',d'}\left(z\right) & =\delta_{d,d'}\delta\left(k-k'\right)
\end{align*}

\end_inset

where 
\begin_inset Formula $d\in\left\{ \rightarrow,\leftarrow\right\} $
\end_inset

.
 We can write this using 
\begin_inset Formula $\varepsilon=U\left(0\right)+\frac{\hbar^{2}k^{2}}{2m^{*}}$
\end_inset

 as
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}^{\rightarrow}\left(z,E\right) & =\frac{1}{4\pi}\left(\frac{2m^{*}}{\hbar^{2}}\right)^{3/2}\int^{E}_{U\left(0\right)}\frac{\mathrm{d}\varepsilon}{\sqrt{\varepsilon-U_{0}}}\left|\psi_{\varepsilon}\left(z\right)\right|^{2}\Theta\left(E-\varepsilon\right)
\end{align*}

\end_inset

where 
\begin_inset Formula $\mathrm{d}k=\frac{m^{*}}{\hbar^{2}k\left(\varepsilon\right)}\mathrm{d}\varepsilon=\frac{1}{2}\frac{\sqrt{2m^{*}}}{\hbar}\frac{\mathrm{d}\varepsilon}{\sqrt{\varepsilon-U_{0}}}$
\end_inset

.
\end_layout

\begin_layout Section
Bulk
\end_layout

\begin_layout Standard
For 3D bulk with 
\begin_inset Formula $\psi_{n}\left(z\right)\to\psi_{k_{z}}\left(z\right)=\frac{1}{\sqrt{L}}\mathrm{e}^{ik_{z}z}$
\end_inset

 and 
\begin_inset Formula $E_{n}\to\varepsilon=E_{c}+\frac{\hbar^{2}k^{2}_{z}}{2m^{*}}$
\end_inset

,
 this reduces to
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}\left(z,E\right)\to\mathrm{DOS}\left(E\right) & =\frac{m^{*}}{\pi\hbar^{2}L}\frac{L}{2\pi}2\int^{\infty}_{0}\mathrm{d}k_{z}\,\Theta\left(E-E_{c}-\frac{\hbar^{2}k^{2}_{z}}{2m^{*}}\right)\\
 & =\frac{m^{*}}{\pi\hbar^{2}L}\frac{L}{2\pi}2\int^{\infty}_{E_{c}}\mathrm{d}\varepsilon\,\frac{1}{2}\frac{\sqrt{2m^{*}}}{\hbar}\frac{1}{\sqrt{\varepsilon-E_{c}}}\,\Theta\left(E-\varepsilon\right)\\
 & =\left(\frac{2m^{*}}{\hbar^{2}}\right)^{3/2}\frac{1}{4\pi^{2}}\int^{\infty}_{0}\mathrm{d}\xi\,\xi^{-1/2}\,\Theta\left(E-E_{c}-\xi\right)\\
 & =\frac{1}{2\pi^{2}}\left(\frac{2m^{*}}{\hbar^{2}}\right)^{3/2}\sqrt{E-E_{c}}\,\Theta\left(E-E_{c}\right)
\end{align*}

\end_inset


\begin_inset Note Note
status collapsed

\begin_layout Plain Layout
\begin_inset Formula 
\begin{align*}
\mathrm{LDOS}\left(z,E\right) & =\frac{m^{*}}{\pi\hbar^{2}}\frac{1}{\Delta k}2\int^{\infty}_{0}\mathrm{d}k\frac{1}{L}\Theta\left(E-E_{c}-\frac{\hbar^{2}k^{2}}{2m^{*}}\right)\\
 & =\frac{m^{*}}{\pi\hbar^{2}}\frac{L}{2\pi}\frac{1}{L}2\int^{\infty}_{E_{c}}\mathrm{d}\varepsilon\frac{m^{*}}{\hbar^{2}\frac{\sqrt{2m^{*}}}{\hbar}\sqrt{\varepsilon-E_{c}}}\Theta\left(E-\varepsilon\right)\\
 & =\frac{1}{4\pi^{2}}\left(\frac{2m^{*}}{\hbar^{2}}\right)^{3/2}\int^{\infty}_{E_{c}}\mathrm{d}\varepsilon\frac{1}{\sqrt{\varepsilon-E_{c}}}\Theta\left(E-\varepsilon\right)\\
\xi=\varepsilon-E_{c}\qquad & =\frac{1}{4\pi^{2}}\left(\frac{2m^{*}}{\hbar^{2}}\right)^{3/2}\int^{E-E_{c}}_{0}\mathrm{d}\xi\,\xi^{-1/2}\\
 & =\frac{1}{2\pi^{2}}\left(\frac{2m^{*}}{\hbar^{2}}\right)^{3/2}\sqrt{E-E_{c}}\\
\\\varepsilon & =E_{c}+\frac{\hbar^{2}k^{2}}{2m^{*}}\\
\mathrm{d}\varepsilon & =\frac{\hbar^{2}k}{m^{*}}\mathrm{d}k\\
\end{align*}

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Section
Schrödinger Equation with Open Boundary Conditions
\end_layout

\begin_layout Standard
We assume a confinement potential 
\begin_inset Formula $U\left(z\right)$
\end_inset

 on a finite domain 
\begin_inset Formula $z\in\left(0,L\right)$
\end_inset

.
 Outside of this domain,
 we assume a constant continuation of the potential 
\begin_inset Formula $U\left(z\leq0\right)=U\left(0\right)$
\end_inset

 and 
